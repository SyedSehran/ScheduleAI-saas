# ===== ScheduleAI API configuration =====
# Copy this file to .env and adjust values.

# Server
PORT=4000
NODE_ENV=development

# MongoDB connection string (local instance or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/scheduleai

# JWT authentication.
# Generate a strong secret with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Optional local LLM (Ollama) used for AI prompt parsing / optimization tips.
# When Ollama is offline the API automatically falls back to heuristic mode,
# so these two lines are safe to leave as-is.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=neural-chat
